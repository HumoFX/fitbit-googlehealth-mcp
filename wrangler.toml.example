name = "fitbit-googlehealth-mcp"
main = "src/index.ts"
compatibility_date = "2025-11-01"
compatibility_flags = ["nodejs_compat"]

[vars]
# Anthropic's published outbound CIDR for Claude → MCP server connections.
ALLOWED_CIDRS = "160.79.104.0/21"

# Which backend serves the tools: "fitbit" (default, full tool set) or
# "google_health" (read MVP; requires GOOGLE_* secrets and gh_* tokens).
HEALTH_PROVIDER = "fitbit"

# Create both KV namespaces before `wrangler deploy`:
#   wrangler kv:namespace create TOKENS
#   wrangler kv:namespace create CACHE
# Then paste the returned ids below.

[[kv_namespaces]]
binding = "TOKENS"
id = "<your-tokens-namespace-id>"

[[kv_namespaces]]
binding = "CACHE"
id = "<your-cache-namespace-id>"

# Set the following secrets:
#   wrangler secret put FITBIT_CLIENT_ID
#   wrangler secret put FITBIT_CLIENT_SECRET
#   wrangler secret put MCP_SHARED_SECRET   # `openssl rand -base64 32`
#
# For HEALTH_PROVIDER = "google_health" (Google Cloud OAuth client):
#   wrangler secret put GOOGLE_CLIENT_ID
#   wrangler secret put GOOGLE_CLIENT_SECRET

# Multi-user mode (optional): bind OAUTH_KV to turn the Worker into an OAuth
# server so anyone can connect it with their own Google account. Create with
#   wrangler kv namespace create OAUTH_KV
# and add the Worker's callback URL to the Google OAuth client's Authorized
# redirect URIs: https://<worker>.<subdomain>.workers.dev/oauth/google/callback
# Without this binding the Worker stays single-user (shared-secret URL).
# [[kv_namespaces]]
# binding = "OAUTH_KV"
# id = "<your-oauth-kv-namespace-id>"
